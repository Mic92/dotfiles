+    async fn set_raw_password_hash(handler: &SqlOpaqueHandler, username: &str, hash: &[u8]) {
+        let user_update = model::users::ActiveModel {
+            user_id: ActiveValue::Set(UserId::new(username)),
+            password_hash: ActiveValue::Set(Some(hash.to_vec())),
+            ..Default::default()
+        };
+        user_update.update(&handler.sql_pool).await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn test_legacy_hash_upgraded_on_bind() {
+        let sql_pool = get_initialized_db().await;
+        let handler = SqlOpaqueHandler::new(generate_random_private_key(), sql_pool.clone());
+        insert_user_no_password(&handler, "bob").await;
+        // {SSHA} hash of "bob00".
+        set_raw_password_hash(
+            &handler,
+            "bob",
+            b"{SSHA}DypVsm4xDs0vEuyWL+Q4fbUU0r5zYWx0eTEyMw==",
+        )
+        .await;
+
+        // Wrong password: hash stays legacy.
+        handler
+            .bind(BindRequest {
+                name: UserId::new("bob"),
+                password: "wrong_password".to_string(),
+            })
+            .await
+            .unwrap_err();
+        assert!(
+            handler
+                .get_password_file_for_user(UserId::new("bob"))
+                .await
+                .unwrap()
+                .unwrap()
+                .starts_with(b"{SSHA}")
+        );
+
+        // Correct password: hash is upgraded to OPAQUE.
+        handler
+            .bind(BindRequest {
+                name: UserId::new("bob"),
+                password: "bob00".to_string(),
+            })
+            .await
+            .unwrap();
+        assert!(
+            !handler
+                .get_password_file_for_user(UserId::new("bob"))
+                .await
+                .unwrap()
+                .unwrap()
+                .starts_with(b"{SSHA}")
+        );
+
+        handler
+            .bind(BindRequest {
+                name: UserId::new("bob"),
+                password: "bob00".to_string(),
+            })
+            .await
+            .unwrap();
+        attempt_login(&handler, "bob", "bob00").await.unwrap();
+        attempt_login(&handler, "bob", "wrong_password")
+            .await
+            .unwrap_err();
+    }
+
