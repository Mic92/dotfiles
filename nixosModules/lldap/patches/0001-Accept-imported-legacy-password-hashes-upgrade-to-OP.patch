+++ b/crates/sql-backend-handler/src/legacy_password.rs
@@ -0,0 +1,78 @@
+//! Verification of legacy password hashes ({ARGON2}, {SSHA}, {CRYPT})
+//! imported from another LDAP server. They are upgraded to OPAQUE records
+//! on the first successful LDAP simple bind, since only then the server
+//! sees the clear-text password.
+
+use base64::Engine;
+use sha1::{Digest, Sha1};
+
+/// Returns `None` for OPAQUE records, otherwise whether the password matches.
+pub(crate) fn check_legacy_password(stored: &[u8], clear_password: &str) -> Option<bool> {
+    let stored = std::str::from_utf8(stored).ok()?;
+    if let Some(phc) = stored.strip_prefix("{ARGON2}") {
+        Some(argon2::verify_encoded(phc, clear_password.as_bytes()).unwrap_or(false))
+    } else if let Some(b64) = stored.strip_prefix("{SSHA}") {
+        Some(verify_ssha(b64, clear_password))
+    } else {
+        stored
+            .strip_prefix("{CRYPT}")
+            .map(|crypt| pwhash::unix::verify(clear_password, crypt))
+    }
+}
+
+fn verify_ssha(b64: &str, clear_password: &str) -> bool {
+    let Ok(bytes) = base64::engine::general_purpose::STANDARD.decode(b64) else {
+        return false;
+    };
+    if bytes.len() < 20 {
+        return false;
+    }
+    let (digest, salt) = bytes.split_at(20);
+    let mut hasher = Sha1::new();
+    hasher.update(clear_password.as_bytes());
+    hasher.update(salt);
+    hasher.finalize().as_slice() == digest
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // Generated with python hashlib, the argon2 CLI and openssl passwd -5/-6.
+    const SSHA: &[u8] = b"{SSHA}DypVsm4xDs0vEuyWL+Q4fbUU0r5zYWx0eTEyMw==";
+    const ARGON2: &[u8] =
+        b"{ARGON2}$argon2id$v=19$m=4096,t=3,p=1$c29tZXNhbHQwMA$FAN6ACZfVmxmOw58Gi4Y8RTtQ3prFG+nlVcptlOw1Wg";
+    const CRYPT_SHA512: &[u8] = b"{CRYPT}$6$abcdefgh$gptQHNP7ieegB6CIGpK5H5Tq8wt0xAltHa/Dy2wJl8CbmYgh9/C7tGgXHb6A2ve6grndHCkrWGnD/FYsVqMVM/";
+    const CRYPT_SHA256: &[u8] = b"{CRYPT}$5$abcdefgh$pLLojuDUisGN23rHl2fB6ne6h3wQWCnFGM2zF.kW2v2";
+
+    #[test]
+    fn test_legacy_hashes_match() {
+        for hash in [SSHA, ARGON2, CRYPT_SHA512, CRYPT_SHA256] {
+            assert_eq!(check_legacy_password(hash, "bob00"), Some(true));
+            assert_eq!(check_legacy_password(hash, "wrong"), Some(false));
+        }
+    }
+
+    #[test]
+    fn test_opaque_record_is_not_legacy() {
+        assert_eq!(check_legacy_password(&[0xff, 0x00, 0x12], "bob00"), None);
+        assert_eq!(check_legacy_password(b"no prefix at all", "bob00"), None);
+    }
+
+    #[test]
+    fn test_malformed_legacy_hashes() {
+        assert_eq!(check_legacy_password(b"{SSHA}!!!", "bob00"), Some(false));
+        assert_eq!(
+            check_legacy_password(b"{SSHA}c2hvcnQ=", "bob00"),
+            Some(false)
+        );
+        assert_eq!(
+            check_legacy_password(b"{ARGON2}garbage", "bob00"),
+            Some(false)
+        );
+        assert_eq!(
+            check_legacy_password(b"{CRYPT}$9$nope", "bob00"),
+            Some(false)
+        );
+    }
+}
