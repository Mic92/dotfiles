host := "rauter"
version := "$(curl --silent https://api.github.com/repos/openwrt/openwrt/releases/latest | jq -r '.. .name? // empty | gsub(\"^v\"; \"\")')"
sysupgrade_url := "https://downloads.openwrt.org/releases/" + version + "/targets/mediatek/mt7622/openwrt-" + version + "-mediatek-mt7622-linksys_e8450-ubi-squashfs-sysupgrade.itb"
ssh_opts := "-o IdentitiesOnly=yes -o BatchMode=yes -i ~/.ssh/id_ed25519_rauter"

ssh +command:
  ssh {{ssh_opts}} "root@{{host}}" {{quote(command)}}

# apply example.nix (packages, files, uci, root password) to the router
apply:
  nix run ../#openwrt-rauter -- "root@{{host}}" {{ssh_opts}}

# perform router upgrade
upgrade:
  wget "{{sysupgrade_url}}" -O openwrt.sysupgrade.itb
  scp -O {{ssh_opts}} openwrt.sysupgrade.itb "root@{{host}}:/tmp/openwrt.sysupgrade.itb"
  just host={{host}} ssh "sysupgrade -T /tmp/openwrt.sysupgrade.itb"
  just host={{host}} ssh "sysupgrade -v /tmp/openwrt.sysupgrade.itb" || true
  # without this, the ping below succeeds before the router has gone down
  while ssh {{ssh_opts}} -o ConnectTimeout=3 "root@{{host}}" true 2>/dev/null; do sleep 2; done
  while ! ping -c1 -W1 8.8.8.8; do sleep 2; done
  while ! ssh {{ssh_opts}} -o ConnectTimeout=3 "root@{{host}}" true; do sleep 2; done
  just host={{host}} apply

