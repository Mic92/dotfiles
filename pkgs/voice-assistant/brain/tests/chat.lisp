(define-test chat-body-names-the-part
  :parent va-tests
  (dolist (va::*late* '(nil t))
    (loop repeat 20
          for r = (va::body-reply "a bum")
          do (true (search "bum" (string-downcase r)) "~a" r)
          (false (search "a bum" r) "~a" r)
          (true (upper-case-p (char r 0)) "~a" r))))

(define-test chat-keeps-its-sleep-talk-apart
  :parent va-tests
  (parses-not "Chat(Sleep)" '("how do i sleep better" "do you think i sleep enough" "go to sleep"))
  (parses-not "NapQuestion" '("do you ever get tired of me" "i'm tired"))
  (parses-not "Chat(Feelings)" '("are you happy with the weather" "i feel sad")))
