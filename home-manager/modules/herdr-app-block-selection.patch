diff --git a/src/vt.rs b/src/vt.rs
index 4c63bf6..955d302 100644
--- a/src/vt.rs
+++ b/src/vt.rs
@@ -1109,6 +1109,17 @@ impl Vt {
         Ok(())
     }
 
+    /// A rectangular selection with `at` and `end` as opposite corners; either may be an empty cell.
+    pub fn select_block(&mut self, at: Option<CellPosition>, end: Option<CellPosition>) -> Result<(), String> {
+        let at = at.unwrap_or_else(|| self.cursor_position());
+        let end = end.unwrap_or(at);
+        let start = self.grid_ref(GHOSTTY_POINT_TAG_SCREEN, at.col, at.row).ok_or("terminal.select at is outside the screen and history")?;
+        let end = self.grid_ref(GHOSTTY_POINT_TAG_SCREEN, end.col, end.row).ok_or("terminal.select end is outside the screen and history")?;
+        let selection = GhosttySelection { size: std::mem::size_of::<GhosttySelection>(), start, end, rectangle: true, ..Default::default() };
+        unsafe { ghostty_terminal_set(self.term, GHOSTTY_TERMINAL_OPT_SELECTION, &selection as *const _ as *const c_void); }
+        Ok(())
+    }
+
     pub fn adjust_selection(&mut self, direction: &str) -> Result<(), String> {
         let adjustment = match direction {
             "left" => GHOSTTY_SELECTION_ADJUST_LEFT,
@@ -2058,6 +2069,26 @@ mod tests {
         assert_eq!(vt.selection_positions().unwrap().end.row, 0);
     }
 
+    #[test]
+    fn block_selection_copies_a_column_range_from_each_row() {
+        let mut vt = Vt::new(30, 4);
+        vt.write(b"ab one\r\ncd two\r\n\r\nef three");
+        let corner = |row, col| Some(CellPosition { row, col });
+        vt.select_block(corner(0, 3), corner(1, 5)).unwrap();
+        assert_eq!(vt.selection_text().as_deref(), Some("one\ntwo"));
+        let frame = vt.frame();
+        assert_ne!(frame.rows[0][6].bg, Some(theme().selection_bg));
+        assert_ne!(frame.rows[1][0].bg, Some(theme().selection_bg));
+        assert_eq!(frame.rows[1][3].bg, Some(theme().selection_bg));
+        // The moving end may sit on an empty cell and precede the anchor.
+        vt.select_block(corner(3, 4), corner(2, 3)).unwrap();
+        assert_eq!(vt.selection_positions(), Some(SelectionPositions { start: CellPosition { row: 3, col: 4 }, end: CellPosition { row: 2, col: 3 } }));
+        assert_eq!(vt.selection_text().as_deref(), Some("\nth"));
+        vt.select_block(None, None).unwrap();
+        assert_eq!(vt.selection_positions().map(|s| s.start), Some(vt.cursor_position()));
+        assert!(vt.select_block(corner(0, 0), corner(100, 0)).is_err());
+    }
+
