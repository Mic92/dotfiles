From 3212e83943298fcdf9df7ed4742fdf71a893a3c7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=B6rg=20Thalheim?= <joerg@thalheim.io>
Date: Sun, 26 Jul 2026 10:43:42 +0200
Subject: [PATCH] remote: make ssh transport program configurable
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

herdr --remote hardcodes the OpenSSH client binary. Most ssh-invoking
tools grew an escape hatch for this (GIT_SSH_COMMAND, rsync -e,
BORG_RSH, ansible ssh_executable) because users need it for reasons
plain ssh_config cannot cover: corporate bastion wrappers that inject
short-lived certificates (Teleport tsh, gcloud compute ssh, aws ssm),
picking a specific ssh build, debugging wrappers, stub transports in
tests, or roaming transports such as mosh/Eternal Terminal
(discussion #1780) - all without shadowing ssh in PATH for every
process on the machine.

Add remote.ssh_command (default "ssh") and use it for both the
bootstrap commands and the stdio bridge. The replacement only needs to
accept OpenSSH-compatible arguments (-T <target> <command>).

Signed-off-by: Jörg Thalheim <joerg@thalheim.io>
---
 src/config/model.rs  |  4 ++++
 src/main.rs          |  3 +++
 src/remote/attach.rs | 15 ++++++++++++---
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/src/config/model.rs b/src/config/model.rs
index 6ef6274d..4b9bf296 100644
--- a/src/config/model.rs
+++ b/src/config/model.rs
@@ -1023,12 +1023,16 @@ pub struct RemoteConfig {
     /// Add keepalive fallbacks and private connection reuse for `herdr --remote`.
     /// Set false to run plain ssh unchanged. Default: true.
     pub manage_ssh_config: bool,
+    /// Program used for the ssh transport of `herdr --remote`. Must accept
+    /// OpenSSH-compatible arguments (`-T <target> <command>`). Default: "ssh".
+    pub ssh_command: String,
 }
 
 impl Default for RemoteConfig {
     fn default() -> Self {
         Self {
             manage_ssh_config: true,
+            ssh_command: "ssh".to_string(),
         }
     }
 }
diff --git a/src/main.rs b/src/main.rs
index 8cfe9b0b..94ba0bb8 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -403,6 +403,9 @@ const DEFAULT_CONFIG: &str = r##"# herdr configuration
 # Set false to run plain ssh against your ssh config unchanged — this does not
 # force keepalive or multiplexing off, it only stops herdr from adding its own.
 # manage_ssh_config = true
+# Program used as the ssh transport (remote attach and saved machines). It must
+# accept OpenSSH-compatible arguments (`-T <target> <command>`).
+# ssh_command = "ssh"
 
 [experimental]
 # Allow launching herdr from inside a herdr-managed pane.
diff --git a/src/remote/attach.rs b/src/remote/attach.rs
index 6a1ee6f9..4131e171 100644
--- a/src/remote/attach.rs
+++ b/src/remote/attach.rs
@@ -16,7 +16,7 @@ use interprocess::TryClone as _;
 use serde::Deserialize;
 use std::sync::{
     atomic::{AtomicBool, Ordering},
-    mpsc, Arc,
+    mpsc, Arc, OnceLock,
 };
 use std::thread::{self, JoinHandle};
 use std::time::{Duration, Instant};
@@ -600,7 +600,7 @@ impl RemoteSsh {
     }
 
     fn base_command(&self) -> Command {
-        let mut command = Command::new("ssh");
+        let mut command = Command::new(ssh_program());
         apply_managed_ssh_options(&mut command, self.options());
         command
     }
@@ -2707,6 +2707,15 @@ pub(crate) fn bridge_upload_cancellation_for_test(
     }
 }
 
+/// Program used as the ssh transport; `remote.ssh_command` lets users swap in
+/// roaming or certificate-injecting wrappers without shadowing ssh in PATH.
+fn ssh_program() -> String {
+    static PROGRAM: OnceLock<String> = OnceLock::new();
+    PROGRAM
+        .get_or_init(|| crate::config::Config::load().config.remote.ssh_command)
+        .clone()
+}
+
 fn bridge_connection(
     mut stream: crate::ipc::LocalStream,
     target: &str,
@@ -2716,7 +2725,7 @@ fn bridge_connection(
     bridge_stop: &Arc<AtomicBool>,
 ) -> io::Result<()> {
     let upload_stop = Arc::new(BridgeUploadStop::new()?);
-    let mut command = Command::new("ssh");
+    let mut command = Command::new(ssh_program());
     apply_managed_ssh_options(&mut command, ssh_options);
     if noninteractive {
         apply_noninteractive_ssh_options(&mut command);
-- 
